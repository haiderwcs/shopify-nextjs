#!/usr/bin/env python3
"""Controlled stand-in for `codex exec --json --output-last-message FILE -` (tests only)."""
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "lib"))
from sfactory import fake_provider  # noqa: E402

argv = sys.argv[1:]
if argv[:1] == ["--version"]:
    print("codex-cli 0.0.0 (stub)")
    sys.exit(0)
if argv[:2] == ["exec", "--help"]:
    print("--output-last-message --output-schema --sandbox -s -C --cd --json --skip-git-repo-check --add-dir -m --model")
    sys.exit(0)
assert argv[0] == "exec" and argv[-1] == "-", argv
prompt = sys.stdin.read()
cwd = Path(argv[argv.index("-C") + 1])
out = argv[argv.index("--output-last-message") + 1]
log = os.environ.get("FACTORY_STUB_LOG")
if log:
    with open(log, "a") as f:
        f.write(json.dumps({"bin": "codex", "argv": argv, "cwd": str(cwd),
                            "role": fake_provider.parse_header(prompt)["role"]}) + "\n")
model = argv[argv.index("-m") + 1] if "-m" in argv else None
if model and model.lower().startswith(("claude", "haiku", "sonnet", "opus", "fable")):
    print(json.dumps({"type": "error", "message": f"model {model} not supported"}))
    sys.exit(1)
print(json.dumps({"type": "thread.started", "thread_id": "stub"}))
try:
    text = fake_provider.respond(None, prompt, cwd, os.environ)
except fake_provider.FakeFailure as e:
    print(json.dumps({"type": "turn.failed", "error": {"message": f"stub failure: {e.kind}"}}))
    sys.exit(1)
Path(out).write_text(text)
print(json.dumps({"type": "turn.completed", "usage": {"input_tokens": 120, "cached_input_tokens": 20,
                                                      "output_tokens": 40}}))
