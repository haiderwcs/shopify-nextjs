{
  "_comment": "Software factory settings. Keys starting with _ are notes. See factory/README.md for every key.",
  "concurrency": 3,
  "max_rounds": 3,
  "remote": "origin",
  "repository": null,
  "base_branch": "main",
  "merge_method": "merge",
  "merge_policy": "manual",
  "default_host": "claude",
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human"
  },
  "routing": {
    "low":    { "code": "haiku" },
    "medium": { "code": "sonnet" },
    "high":   { "code": "sonnet" }
  },
  "surface_reviewers": {
    "ui": { "ux": "sonnet", "ui": "haiku" },
    "security": { "security": "opus" }
  },
  "surface_paths": {
    "ui": ["components/*", "pages/_app.js", "pages/_document.js", "pages/index.js", "pages/products/*",
           "styles/*", "public/*", "tailwind.config.js", "postcss.config.js"],
    "security": ["lib/shopify.js", "pages/api/*", "context/*", "components/MiniCart.js", "next.config.js",
                 ".env*", "package.json", "package-lock.json", "*auth*"]
  },
  "protected_paths": ["factory/*", ".claude/*", ".agents/*", "AGENTS.md", "CLAUDE.md"],
  "ports": { "base": 5100, "step": 10 },
  "checks_env": {
    "_comment": "The gate passes only these names from this file (in the controller checkout) to checks.sh, and redacts their values from logs.",
    "file": ".env.local",
    "names": ["SHOPIFY_STORE_DOMAIN", "SHOPIFY_STOREFRONT_ACCESSTOKEN"]
  },
  "role_timeout_seconds": 1800,
  "checks_timeout_seconds": 1800,
  "max_attempts": 2,
  "max_refresh": 2,
  "gh_bin": "gh",
  "hosts": {
    "claude": {
      "bin": "claude",
      "models": { "intake": "fable", "spec-writer": "opus", "builder": "opus", "approver": "opus" },
      "tiers": { "haiku": "haiku", "sonnet": "sonnet", "opus": "opus" }
    },
    "codex": {
      "_comment": "null uses the Codex account's default model. Set OpenAI model names here (never Claude names) to split cheap and capable roles.",
      "bin": "codex",
      "models": { "intake": null, "spec-writer": null, "builder": null, "approver": null },
      "tiers": { "haiku": null, "sonnet": null, "opus": null }
    }
  },
  "prices_usd_per_mtok": {
    "_comment": "Used only to calculate cost when a provider reports tokens but no cost (Codex). Claude's CLI reports its own cost.",
    "claude-fable-5-1":  { "input": 10.0, "output": 50.0, "cache_write_5m": 12.5, "cache_write_1h": 20.0, "cache_read": 0.25 },
    "claude-opus-5-5":   { "input": 4.0,  "output": 20.0, "cache_write_5m": 5.0,  "cache_write_1h": 8.0,  "cache_read": 0.20 },
    "claude-sonnet-5-5": { "input": 2.0,  "output": 10.0, "cache_write_5m": 2.5,  "cache_write_1h": 4.0,  "cache_read": 0.20 },
    "claude-haiku-5-5":  { "input": 0.10, "output": 0.50, "cache_write_5m": 0.125, "cache_write_1h": 0.20, "cache_read": 0.01 }
  }
}
