#!/usr/bin/env python3
"""The deterministic gate: does the job's branch pass the repo's checks?

Usage:
  gate <job-id>            write round-N/checks.md (+ checks.log); exit 0 on PASS, 1 on FAIL
  gate <job-id> --merge    same, as round-N/merge-checks.md
  gate --hook              builder Stop hook (Claude Code native path): run the checks once, exit 2 on failure

Runs the controller checkout's factory/checks.sh in the job's worktree, so a
branch can't change the checks it is judged by, and fails any branch that adds,
edits, renames or deletes a file under config.json `protected_paths`. Every
result names the commit it judged.
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from sfactory.gate import gate, run_checks  # noqa: E402
from sfactory.jobs import Factory  # noqa: E402
from sfactory.util import Refused  # noqa: E402


def hook(fac):
    event = json.load(sys.stdin)
    if event.get("stop_hook_active"):
        sys.exit(0)  # one nudge per stop; the gate decides
    path = event.get("agent_transcript_path") or event.get("transcript_path")
    if not path:
        sys.exit(0)
    with open(Path(path).expanduser()) as f:
        content = json.loads(f.readline())["message"]["content"]
    prompt = content if isinstance(content, str) else " ".join(b.get("text", "") for b in content)
    if "Job: " not in prompt:
        sys.exit(0)
    job = fac.store.load(prompt.split("Job: ", 1)[1].split(".", 1)[0])
    code, log, _ = run_checks(fac.cfg, fac.repo, job["worktree"])
    if code != 0:
        tail = "\n".join(log.rstrip().splitlines()[-40:])
        print(f"factory/checks.sh fails in your worktree (exit {code}). The gate will reject this build. "
              f"Fix it, or write STATUS: BLOCKED in build.md if you can't.\n\n{tail}", file=sys.stderr)
        sys.exit(2)


def main(argv):
    try:
        fac = Factory()
        if argv == ["--hook"]:
            return hook(fac)
        if len(argv) in (1, 2) and not argv[0].startswith("-") and (len(argv) == 1 or argv[1] == "--merge"):
            job = fac.resolve(argv[0])
            if job["round"] < 1:
                raise Refused(f"{job['id']} hasn't started a build round")
            verdict, commit, path, code, secs, protected = gate(fac.cfg, fac.repo, job, fac.round_dir(job),
                                                                merge=len(argv) == 2)
            fac.store.event(job["id"], "gate", verdict=verdict, commit=commit, exit=code, seconds=secs)
            print(f"GATE: {verdict} ({job['id']} round {job['round']}, {commit[:7]}, checks.sh exit {code} in {secs}s"
                  + (f", protected paths changed: {', '.join(protected)}" if protected else "") + ")")
            sys.exit(0 if verdict == "PASS" else 1)
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)
    except Refused as e:
        print(f"gate: {e}", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
