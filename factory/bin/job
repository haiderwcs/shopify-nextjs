#!/usr/bin/env python3
"""The only writer of factory/jobs/<job-id>/job.json.

Every stage change goes through `advance`, which checks the evidence that
justifies it and refuses anything else. The terminal runner (factory/bin/factory
run) and a Claude Code /factory session both move jobs only through this module.

Usage:
  job queue                      read-only: what a run would do with each labeled issue
  job reconcile                  record external merges/closes and removed labels (writes)
  job create <issue>             new job for an open, labeled issue; prints the job id
  job advance <job> <stage>      move a job to <stage>, or refuse
  job publish <job>              APPROVE → apply merge_policy (manual: awaiting-merge; auto: merge)
  job merge <job>                auto policy only: merge the approved head; refused under manual
  job feedback <job>             answer (needs-info) or revision (needs-human/awaiting-merge), text on stdin
  job reject <job>               reject a waiting job, reason on stdin
  job agents <job> <json>        record the routed reviewer set (called by factory/bin/route)
  job sync <job>                 refresh gate, reviews and evidence from the job's files
  job summary [<job>...]         table of jobs

<job> is a job id (004-dark-mode) or an issue number (12).
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from sfactory.jobs import Factory, cost_text, elapsed  # noqa: E402
from sfactory.util import Refused, redact  # noqa: E402


def die(msg):
    print(f"job: {redact(msg)}", file=sys.stderr)
    sys.exit(1)


def mutate(fac, arg, fn):
    job = fac.resolve(arg)
    with fac.store.lock(job["id"]):
        job = fac.sync(fac.store.load(job["id"]))
        fac.check_owner(job)
        result = fn(job)
        fac.save(fac.sync(job))
    return job, result


def main(argv):
    if not argv or argv[0] in {"-h", "--help"}:
        print(__doc__.strip())
        return
    cmd, args = argv[0], argv[1:]
    try:
        fac = Factory()
        if cmd == "queue" and not args:
            for row in fac.queue_rows():
                print("\t".join(str(c) for c in row))
        elif cmd == "reconcile" and not args:
            fac.reconcile()
        elif cmd == "create" and len(args) == 1 and args[0].isdigit():
            job_id, created = fac.create(int(args[0]))
            print(job_id if created else f"{job_id} (existing)")
        elif cmd == "advance" and len(args) == 2:
            job, _ = mutate(fac, args[0], lambda j: fac.advance(j, args[1]))
            print(f"{job['id']}: {job['stage']} (round {job['round']})")
        elif cmd == "publish" and len(args) == 1:
            target = "merging" if fac.cfg["merge_policy"] == "auto" else "awaiting-merge"
            job, _ = mutate(fac, args[0], lambda j: fac.advance(j, target))
            if target == "merging":
                job, msg = mutate(fac, args[0], fac.merge)
                print(msg)
            else:
                print(f"{job['id']}: approved; awaiting human merge of PR #{job['pr']}")
        elif cmd == "merge" and len(args) == 1:
            if fac.cfg["merge_policy"] != "auto":
                die("merge_policy is manual: the factory never merges. Merge the PR on GitHub; "
                    "`job reconcile` records it.")
            job, msg = mutate(fac, args[0], fac.merge)
            print(msg)
        elif cmd == "feedback" and len(args) == 1:
            text = sys.stdin.read()
            _, msg = mutate(fac, args[0], lambda j: fac.feedback(j, text))
            print(msg)
        elif cmd == "reject" and len(args) == 1:
            text = sys.stdin.read()
            _, msg = mutate(fac, args[0], lambda j: fac.reject(j, text))
            print(msg)
        elif cmd == "agents" and len(args) == 2:
            def set_agents(j):
                if (j.get("intake") or {}).get("decision") != "ACCEPT" or j["stage"] != "intake":
                    raise Refused(f"{j['id']}: route only an intake job that intake ACCEPTed")
                j["agents"] = json.loads(args[1])
            mutate(fac, args[0], set_agents)
        elif cmd == "sync" and len(args) == 1:
            job, _ = mutate(fac, args[0], lambda j: None)
            reviews = " ".join(f"{k}:{v}" for k, v in (job.get("reviews") or {}).items())
            print(f"{job['id']}: {job['stage']} round {job['round']} gate {job.get('gate') or '-'} {reviews}".rstrip())
        elif cmd == "summary":
            jobs = [fac.resolve(a) for a in args] if args else fac.jobs()
            for j in jobs:
                fac.sync(j)
                print(f"{j['id']}\t#{j['issue']}\t{j['stage']}\tround {j['round']}\t"
                      f"{'#' + str(j['pr']) if j.get('pr') else '-'}\t{cost_text(j)}\t{elapsed(j)}")
        else:
            die(f"bad arguments: {' '.join(argv)}\n\n{__doc__.strip()}")
    except Refused as e:
        die(str(e))


if __name__ == "__main__":
    main(sys.argv[1:])
